version: 1

# Password policy (replaces the one shipped with the image).
# TAK passwords are generated by the platform, never chosen by the user: no
# forced change (pwdMustChange FALSE, otherwise a password set by someone else
# blocks every operation except changing it) and no expiry. Lockout stays on.

dn: ou=Policies,${LDAP_INIT_ORG_DN}
ou: Policies
objectClass: top
objectClass: organizationalUnit

dn: ${LDAP_INIT_PPOLICY_DEFAULT_DN}
objectClass: top
objectClass: device
objectClass: pwdPolicy
cn: DefaultPasswordPolicy
pwdAttribute: userPassword
pwdFailureCountInterval: 300
pwdMaxFailure: 10
pwdMinAge: 0
pwdMustChange: FALSE
pwdSafeModify: FALSE
pwdInHistory: 0
pwdGraceAuthNLimit: 0
pwdLockoutDuration: 300
pwdAllowUserChange: FALSE
pwdExpireWarning: 0
pwdLockout: TRUE
pwdMaxAge: 0
pwdMinLength: 12
pwdCheckQuality: 0
