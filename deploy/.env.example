# Settings of TeamTAK. You do not write this file by hand: ./install.sh generates
# deploy/.env with these variables and random secrets. This example documents them.
# After editing deploy/.env, run ./install.sh again to apply the change.

# --- TeamTAK
# Version of this checkout, from git, set by install.sh at every run: the tag of the
# platform and agent images (teamtak/app, teamtak/agent). The release tag without its "v"
# ("1.0.1"), or between two releases the last one, the number of commits since and the
# commit ("1.0.1-3-g28f8b1b"); the version of Cargo.toml when git cannot tell.
TEAMTAK_VERSION=1.0.1

# --- Mode and addresses
# local: plain HTTP on localhost, mail catcher. production: HTTPS with Let's Encrypt.
MODE=local
# The third file is generated by install.sh from TAK_CLIENT_PORTS and TAK_ADMIN_PORT
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml:data/docker-compose.ports.yml
# Name or address users and TAK clients reach this machine by
PUBLIC_HOST=localhost
PUBLIC_URL=http://localhost:8480
# Interface the published ports listen on
BIND_ADDRESS=127.0.0.1
# Ports of this machine TAK clients connect to, separated by commas. The first goes into the
# zips and QR codes; the others are alternatives for networks that block it, chosen per
# device in the web UI. Each one leads to TAK Server's single TLS input (8089 inside its
# container). Not 8446, nor 8443 (TAK Server's API, where TAK clients read their channels:
# always published), nor the web interface's ports. Run ./install.sh after a change.
TAK_CLIENT_PORTS=8089
# Port of this machine where the platform's administrators open TAK Server's own
# administration pages, after signing in to the platform (Caddy serves them there and
# reaches TAK Server with a certificate of its own). off: not published. Not a client port,
# nor 8443.
TAK_ADMIN_PORT=8444
# true as soon as the UI is served over HTTPS
COOKIE_SECURE=false
ADMIN_EMAIL=you@example.org
ACME_EMAIL=you@example.org

# --- TAK Server
TAK_VERSION=5.8-RELEASE-103
TAK_IMAGE=teamtak/takserver:5.8-RELEASE-103
TAK_DB_IMAGE=teamtak/takserver-db:5.8-RELEASE-103
# Validity of the client certificates issued by enrollment, in days
CERT_VALIDITY_DAYS=365
# Safety net only: the platform pushes group changes itself. Seconds.
LDAP_UPDATE_INTERVAL=60
ROOT_CA_NAME=teamtak-root-ca
INT_CA_NAME=teamtak-ca
SERVER_CERT_NAME=takserver
TAK_API_CERT_NAME=teamtak-api
# Certificate Caddy presents to TAK Server for its administration pages
TAK_ADMIN_UI_CERT_NAME=teamtak-admin-ui
# true: port 8446 presents the Let's Encrypt certificate (needed by QR-code enrollment)
TAK_ENROLL_LETSENCRYPT=false
TAK_ENROLL_URL=https://takserver:8446
TAK_NETWORK_ALIAS=takserver.internal
# Name of the connection in the phones' server list
TAK_CONNECTION_NAME=TeamTAK
# PKCS#12 format of the certificates in zips: modern (AES-256) or legacy (Android 12 and older)
P12_FORMAT=modern
# Java heap sizes in MB; empty lets TAK Server size them from the machine's RAM
TAK_API_MAX_HEAP=
TAK_MESSAGING_MAX_HEAP=
TAK_CONFIG_MAX_HEAP=
TAK_PLUGIN_MANAGER_MAX_HEAP=
TAK_RETENTION_MAX_HEAP=

# --- E-mail (Brevo in production: smtp-relay.brevo.com, port 587, starttls)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls, tls or none
SMTP_TLS=none
MAIL_FROM=TeamTAK <teamtak@localhost>

# --- Limits
DEFAULT_MEMBER_CAP=10
# Per hour. Production defaults: 5, 30 and 30; local mode raises the two per-IP limits so
# the integration tests can be replayed.
LOGIN_MAX_CODES_PER_EMAIL=5
LOGIN_MAX_CODES_PER_IP=30
LOGIN_MAX_FAILURES_PER_IP=30
# Seconds before another login code can be sent to the same address; the sign-in page shows
# the countdown. 60 in production, 5 in local mode so the integration tests do not wait.
LOGIN_RESEND_COOLDOWN_SECONDS=60
# Work asked of the browser before it may request a login code (invisible anti-bot check):
# the browser tries half this many SHA-256 on average, a fraction of a second on a computer,
# about a second on a phone. 10000 to 10000000; empty: 1000000.
LOGIN_CHALLENGE_DIFFICULTY=
RECONCILE_INTERVAL_SECONDS=60
# How often the platform looks at the machine, the services and TAK Server, and evaluates
# the alerts. Seconds. Local mode uses 10 so the integration tests do not wait.
MONITOR_INTERVAL_SECONDS=60
# GitHub repository whose latest release the monitoring compares with the installed version,
# twice a day: owner/name, or off to never ask GitHub. Empty: the one TeamTAK comes from.
RELEASE_REPOSITORY=

# --- Directory
LDAP_BASE_DN=dc=teamtak,dc=internal

# --- Secrets (generated by install.sh; losing APP_SECRET makes the stored TAK passwords
# and zip certificates unreadable)
APP_SECRET=
# Shared by the platform and the host agent
AGENT_TOKEN=
POSTGRES_PASSWORD=
LDAP_ROOT_PW=
LDAP_TAKSERVER_PW=
LDAP_MANAGER_PW=
TAK_DB_PASSWORD=
# Password of TAK Server's keystores and CA keys
TAK_CERT_PASSWORD=
