version: 1

# Password policy (replaces the one shipped with the image).
# TAK passwords are long random strings generated by the platform, never chosen by a user:
# - no forced change (pwdMustChange FALSE, otherwise a password set by someone else blocks
#   every operation except changing it) and no expiry;
# - no lockout: the enrollment port (8446) is exposed, and a lockout would let anyone who
#   knows a username lock that account out. A 24-character random password does not need it.

dn: ou=Policies,${LDAP_INIT_ORG_DN}
ou: Policies
objectClass: top
objectClass: organizationalUnit

dn: ${LDAP_INIT_PPOLICY_DEFAULT_DN}
objectClass: top
objectClass: device
objectClass: pwdPolicy
cn: DefaultPasswordPolicy
pwdAttribute: userPassword
pwdLockout: FALSE
pwdMinAge: 0
pwdMaxAge: 0
pwdMustChange: FALSE
pwdSafeModify: FALSE
pwdInHistory: 0
pwdGraceAuthNLimit: 0
pwdAllowUserChange: FALSE
pwdExpireWarning: 0
pwdMinLength: 12
pwdCheckQuality: 0
