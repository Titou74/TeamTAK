# TAK Server's own administration pages, for the platform's administrators. Imported by the
# Caddyfile of each mode, inside the site that listens on 8444 (published on TAK_ADMIN_PORT
# of the machine by data/docker-compose.ports.yml).
#
# The browser holds no certificate, and TAK Server's 8443 asks for one (TAK clients present
# theirs there, to read their channels). For each request, the platform says whether the
# browser's TeamTAK session belongs to an administrator (the session cookie reaches every
# port of the host); without one, the browser is sent to the sign-in page. Then Caddy passes the request on to TAK Server with a certificate of its own,
# declared administrator there (install.sh, data/caddy/tak-admin/).

forward_auth app:8080 {
	uri /api/tak-admin/authorize
}

reverse_proxy https://takserver:8443 {
	# The platform's session stays between the browser and the platform.
	header_up Cookie "tm_session=[^;]*;?\s*" ""
	# The address the browser uses: TAK Server writes it in its redirects, and accepts a
	# WebSocket (WebTAK) only from a page of that address.
	header_up Host {hostport}
	# TAK Server only speaks HTTPS, and its redirects say so: back to the page's own scheme
	# (plain HTTP in local mode, unchanged in production).
	header_down Location "^https://" "{http.request.scheme}://"
	transport http {
		tls_server_name takserver
		tls_trust_pool file /etc/caddy/tak-admin/ca-chain.pem
		tls_client_auth /etc/caddy/tak-admin/cert.pem /etc/caddy/tak-admin/key.pem
	}
}
